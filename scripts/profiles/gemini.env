# Perfil: colega — só usa Gemini. O mesmo modelo faz implementação e QA,
# mas em FASES separadas (impl primeiro; depois um passe de QA adversarial).
# Uso: ./scripts/orquestrar.sh --profile gemini ...
#
# Gemini CLI em modo não-interativo é `gemini -p "<prompt>"`.
# Se a instalação dele usar outro binário/flag, é só editar as duas linhas abaixo.
CODEX_CMD="gemini -p"    # fase de implementação (Gemini)
CLAUDE_CMD="gemini -p"   # fase de QA (Gemini, passe independente)
