# =============================================================================
# Vibe Check — exemplo de variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` (que é IGNORADO pelo Git) e ajuste os valores.
#   cp .env.example .env
#
# NUNCA coloque segredos reais aqui. Este arquivo é versionado e serve apenas
# como modelo. Deixe as chaves de terceiros VAZIAS até implementá-las.
# =============================================================================

# --- PostgreSQL (usado pelo docker-compose) ----------------------------------
# Credenciais de desenvolvimento local, descartáveis. Troque em qualquer
# ambiente que não seja a sua máquina.
POSTGRES_USER=vibe
POSTGRES_PASSWORD=vibe
POSTGRES_DB=vibe
POSTGRES_PORT=5432

# --- Backend (FastAPI) -------------------------------------------------------
APP_ENV=development
# Deve apontar para o Postgres acima. Formato: driver + credenciais + host/porta/db
DATABASE_URL=postgresql+psycopg2://vibe:vibe@localhost:5432/vibe
# Cache de top tracks/artists; valores padrão do PB-08.
MUSIC_SNAPSHOT_TTL_DAYS=7
SPOTIFY_TOP_ITEMS_LIMIT=50
# Origens permitidas para CORS (frontend Vite), separadas por vírgula.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# --- Integrações externas (FORA DO ESCOPO DO PB-01 — deixe VAZIO) ------------
# Preenchidas apenas quando as histórias correspondentes forem implementadas.
# Nunca comitar valores reais.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/callback
ANTHROPIC_API_KEY=
LASTFM_API_KEY=
# Chave Fernet para criptografar tokens em repouso (PB-02). Gere uma própria com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
