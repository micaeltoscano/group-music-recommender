# Vibe Check — local development configuration
# Copy this file to .env and replace the empty values. Never commit real secrets.

# PostgreSQL
POSTGRES_USER=vibe
POSTGRES_PASSWORD=vibe
POSTGRES_DB=vibe
POSTGRES_PORT=5432

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://vibe:vibe@localhost:5432/vibe
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Music data and personal library
MUSIC_SNAPSHOT_TTL_DAYS=7
SPOTIFY_TOP_ITEMS_LIMIT=50
MUSIC_LIBRARY_TTL_DAYS=7
MUSIC_LIBRARY_EXTERNAL_CONCURRENCY=1

# Optional recommendation features
DISCOVERY_MODE_ENABLED=false
BRIDGE_TRACKS_ENABLED=false
SUBGROUP_BALANCING_ENABLED=false
SUBGROUP_MAX_SHARE=0.60

# Contextual candidate pool
CONTEXTUAL_POOL_SHARE=0.50
CONTEXTUAL_POOL_TAG_COUNT=3
CONTEXTUAL_POOL_SEED_COUNT=5
CONTEXTUAL_POOL_TRACKS_PER_SOURCE=4
CONTEXTUAL_POOL_MAX_CANDIDATES=32

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Spotify OAuth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/callback

# Last.fm (optional)
LASTFM_API_KEY=
LASTFM_TIMEOUT_SECONDS=5
LASTFM_CACHE_TTL_DAYS=30

# Token encryption
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Local context interpretation with Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=8
